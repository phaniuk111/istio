    },
    {
      "type": "timeseries",
      "title": "Nodepool Utilization % per Node",
      "description": "Approaching 100 = add nodes. Flat and low = pool can shrink.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 23
      },
      "targets": [
        {
          "expr": "100 * kubernetes_io:node_memory_allocatable_utilization{monitored_resource=\"k8s_node\", node_name=~\".*$nodepool_filter.*\", memory_type=\"non-evictable\"}",
          "legendFormat": "mem {{node_name}}"
        },
        {
          "expr": "100 * kubernetes_io:node_cpu_allocatable_utilization{monitored_resource=\"k8s_node\", node_name=~\".*$nodepool_filter.*\"}",
          "legendFormat": "cpu {{node_name}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "fillOpacity": 5
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Namespace Footprint - % of Pool Capacity",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 23
      },
      "targets": [
        {
          "expr": "100 * sum(container_memory_working_set_bytes{namespace=~\"$namespace\", container!=\"\", container!=\"POD\"}) / sum(last_over_time(kubernetes_io:node_memory_allocatable_bytes{monitored_resource=\"k8s_node\", node_name=~\".*$nodepool_filter.*\"}[10m]))",
          "legendFormat": "memory % of pool"
        },
        {
          "expr": "100 * sum(rate(container_cpu_usage_seconds_total{namespace=~\"$namespace\", container!=\"\", container!=\"POD\"}[5m])) / sum(last_over_time(kubernetes_io:node_cpu_allocatable_cores{monitored_resource=\"k8s_node\", node_name=~\".*$nodepool_filter.*\"}[10m]))",
          "legendFormat": "cpu % of pool"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "decimals": 1,
          "custom": {
            "fillOpacity": 10,
            "thresholdsStyle": {
              "mode": "dashed+area"
            }
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 75
              },
              {
                "color": "red",
                "value": 90
              }
            ]
          }
        },
        "overrides": []
      },
      "description": "Namespace usage as a share of the nodepool allocatable capacity. Dashed lines: amber 75%, red 90%. Below 40% = ample headroom; approaching the red line = add nodes or reclaim."
    },
    {
      "type": "row",
      "title": "Resource Trends (top offenders)",
      "gridPos": {
        "h": 1,
        "w": 24,
        "x": 0,
        "y": 31
      },
      "collapsed": false,
      "panels": []
    },
    {
      "type": "timeseries",
      "title": "CPU % of Limit - Top 8",
      "description": "Flat plateaus at 100 = service pinned at its CPU ceiling.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 32
      },
      "targets": [
        {
          "expr": "topk(8, 100 * max by (namespace, app) (label_replace(kubernetes_io:container_cpu_limit_utilization{monitored_resource=\"k8s_container\", namespace_name=~\"$namespace\", container_name!=\"istio-proxy\"}, \"app\", \"$1\", \"pod_name\", \"(.+)-[a-z0-9]+-[a-z0-9]+$\")))",
          "legendFormat": "{{namespace}}/{{app}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "fillOpacity": 5
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "CPU Throttling % - Top 8",
      "description": "Time frozen by the scheduler. Sustained > 25 = raise CPU limit.",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 32
      },
      "targets": [
        {
          "expr": "topk(8, 100 * max by (namespace, app) (label_replace(rate(container_cpu_cfs_throttled_periods_total{namespace=~\"$namespace\", container!=\"\", container!=\"istio-proxy\", container!=\"POD\"}[5m]), \"app\", \"$1\", \"pod\", \"(.+)-[a-z0-9]+-[a-z0-9]+$\")) / max by (namespace, app) (label_replace(rate(container_cpu_cfs_periods_total{namespace=~\"$namespace\", container!=\"\", container!=\"istio-proxy\", container!=\"POD\"}[5m]), \"app\", \"$1\", \"pod\", \"(.+)-[a-z0-9]+-[a-z0-9]+$\")))",
          "legendFormat": "{{namespace}}/{{app}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Memory % of Limit - Top 8 (OOMKill risk)",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 32
      },
      "targets": [
        {
          "expr": "topk(8, 100 * max by (namespace, app) (label_replace(kubernetes_io:container_memory_limit_utilization{monitored_resource=\"k8s_container\", namespace_name=~\"$namespace\", memory_type=\"non-evictable\", container_name!=\"istio-proxy\"}, \"app\", \"$1\", \"pod_name\", \"(.+)-[a-z0-9]+-[a-z0-9]+$\")))",
          "legendFormat": "{{namespace}}/{{app}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "max": 100,
          "custom": {
            "fillOpacity": 5
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Restarts per Hour - Top 8 (crash loop detector)",
      "description": "Spikes mark restart moments. Any repeating pattern = crash loop: kubectl describe pod -> Last State (OOMKilled vs Error).",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 40
      },
      "targets": [
        {
          "expr": "topk(8, max by (namespace, app) (label_replace(increase(kubernetes_io:container_restart_count{monitored_resource=\"k8s_container\", namespace_name=~\"$namespace\", container_name!=\"istio-proxy\"}[1h]), \"app\", \"$1\", \"pod_name\", \"(.+)-[a-z0-9]+-[a-z0-9]+$\")))",
          "legendFormat": "{{namespace}}/{{app}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "decimals": 0,
          "custom": {
            "fillOpacity": 10
          }
        },
        "overrides": []
      }
    },
    {
      "type": "timeseries",
      "title": "Request Rate & 5xx by Service",
      "datasource": {
        "type": "prometheus",
        "uid": "${datasource}"
      },
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 40
      },
      "targets": [
        {
          "expr": "sum by (namespace, app) (rate(http_server_requests_seconds_count{namespace=~\"$namespace\", uri!~\"/actuator.*\"}[5m]))",
          "legendFormat": "req/s {{namespace}}/{{app}}"
        },
        {
          "expr": "sum by (namespace, app) (rate(http_server_requests_seconds_count{namespace=~\"$namespace\", status=~\"5..\"}[5m])) > 0",
          "legendFormat": "5xx/s {{namespace}}/{{app}}"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "fillOpacity": 5
          }
        },
        "overrides": []
      }
    }
  ],
  "description": "v11 - 2026-08-12: pod-name grouping regex reverted to Deployment-only (all workloads are Deployments); GC % is max (worst replica). GC % now max (worst replica) for consistency with other resource columns; pod-name grouping regex also matches StatefulSet-style names. GC Time % now uses the standard avg(rate(jvm_gc_pause_seconds_sum)) form (seconds-per-second = fraction of wall clock), replacing a thread-count divisor. namespace options are eod, eod1, eod-platform (gateway); eod/eod1 preselected. namespace list filtered to eod/eod1 and both preselected by default. namespace is multi-select (All); services grouped by namespace+app with a Namespace column. service names in the table link through to Service Detail (carries namespace + time range). traffic-light colors, nodepool row (capacity/headroom, 10m-lookback counts), footprint as % of pool with threshold lines, neutral capacity stats, restarts-in-range column, CPU 5m-max columns.",
  "version": 11
}
