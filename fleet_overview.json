{
  "annotations": { "list": [] },
  "editable": true,
  "graphTooltip": 1,
  "schemaVersion": 39,
  "title": "Fleet Overview - All Services (by app)",
  "uid": "fleet-overview-by-app",
  "tags": ["prod-support", "fleet", "gmp", "sizing"],
  "time": { "from": "now-3h", "to": "now" },
  "refresh": "1m",
  "templating": {
    "list": [
      { "name": "datasource", "type": "datasource", "query": "prometheus", "label": "Datasource", "current": {} },
      {
        "name": "namespace", "type": "query",
        "datasource": { "type": "prometheus", "uid": "${datasource}" },
        "query": "label_values(jvm_memory_used_bytes, namespace)",
        "label": "Namespace", "refresh": 2, "sort": 1, "current": {}
      }
    ]
  },
  "panels": [
    {
      "type": "table",
      "title": "Service Health & Sizing - one row per service",
      "description": "'-' = no data (app metrics not yet enabled for that service). Limit columns come from GKE native metrics and show the WORST replica (max), because one pod at 95% of its limit is an OOMKill risk regardless of its siblings. Memory uses non-evictable only - that is what the OOM killer counts. istio-proxy excluded throughout.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 13, "w": 24, "x": 0, "y": 0 },
      "targets": [
        { "refId": "A", "instant": true, "format": "table",
          "expr": "sum by (app) (rate(http_server_requests_seconds_count{namespace=\"$namespace\", uri!~\"/actuator.*\"}[5m]))" },
        { "refId": "B", "instant": true, "format": "table",
          "expr": "sum by (app) (increase(http_server_requests_seconds_count{namespace=\"$namespace\", status=~\"5..\", uri!~\"/actuator.*\"}[$__range]))" },
        { "refId": "C", "instant": true, "format": "table",
          "expr": "1000 * sum by (app) (increase(http_server_requests_seconds_sum{namespace=\"$namespace\", uri!~\"/actuator.*\"}[$__range])) / sum by (app) (increase(http_server_requests_seconds_count{namespace=\"$namespace\", uri!~\"/actuator.*\"}[$__range]))" },
        { "refId": "D", "instant": true, "format": "table",
          "expr": "100 * sum by (app) (jvm_memory_used_bytes{namespace=\"$namespace\", area=\"heap\"}) / sum by (app) (jvm_memory_max_bytes{namespace=\"$namespace\", area=\"heap\"})" },
        { "refId": "E", "instant": true, "format": "table",
          "expr": "100 * sum by (app) (rate(jvm_gc_pause_seconds_sum{namespace=\"$namespace\"}[5m])) / count by (app) (jvm_threads_live_threads{namespace=\"$namespace\"})" },
        { "refId": "F", "instant": true, "format": "table",
          "expr": "100 * max by (app) (label_replace(kubernetes_io:container_memory_limit_utilization{monitored_resource=\"k8s_container\", namespace_name=\"$namespace\", memory_type=\"non-evictable\", container_name!=\"istio-proxy\"}, \"app\", \"$1\", \"pod_name\", \"(.+)-[a-z0-9]+-[a-z0-9]+$\"))" },
        { "refId": "G", "instant": true, "format": "table",
          "expr": "100 * max by (app) (label_replace(kubernetes_io:container_cpu_limit_utilization{monitored_resource=\"k8s_container\", namespace_name=\"$namespace\", container_name!=\"istio-proxy\"}, \"app\", \"$1\", \"pod_name\", \"(.+)-[a-z0-9]+-[a-z0-9]+$\"))" },
        { "refId": "H", "instant": true, "format": "table",
          "expr": "100 * max by (app) (label_replace(rate(container_cpu_cfs_throttled_periods_total{namespace=\"$namespace\", container!=\"\", container!=\"istio-proxy\", container!=\"POD\"}[5m]), \"app\", \"$1\", \"pod\", \"(.+)-[a-z0-9]+-[a-z0-9]+$\")) / max by (app) (label_replace(rate(container_cpu_cfs_periods_total{namespace=\"$namespace\", container!=\"\", container!=\"istio-proxy\", container!=\"POD\"}[5m]), \"app\", \"$1\", \"pod\", \"(.+)-[a-z0-9]+-[a-z0-9]+$\"))" },
        { "refId": "I", "instant": true, "format": "table",
          "expr": "max by (app) (label_replace(container_memory_working_set_bytes{namespace=\"$namespace\", container!=\"\", container!=\"istio-proxy\", container!=\"POD\"}, \"app\", \"$1\", \"pod\", \"(.+)-[a-z0-9]+-[a-z0-9]+$\"))" }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        { "id": "organize", "options": {
            "indexByName": {
              "app": 0,
              "Value #A": 1,
              "Value #B": 2,
              "Value #C": 3,
              "Value #D": 4,
              "Value #E": 5,
              "Value #F": 6,
              "Value #G": 7,
              "Value #H": 8,
              "Value #I": 9
            },
            "renameByName": {
              "app": "Service",
              "Value #A": "Req/s",
              "Value #B": "5xx (range)",
              "Value #C": "Avg Latency (ms)",
              "Value #D": "Heap %",
              "Value #E": "GC Time %",
              "Value #F": "Mem % of Limit",
              "Value #G": "CPU % of Limit",
              "Value #H": "CPU Throttle %",
              "Value #I": "Mem Used (pod)"
            },
            "excludeByName": { "Time": true }
        } },
        { "id": "sortBy", "options": { "sort": [{ "field": "Mem % of Limit", "desc": true }] } }
      ],
      "fieldConfig": {
        "defaults": { "unit": "short", "decimals": 2, "noValue": "-" },
        "overrides": [
          { "matcher": { "id": "byName", "options": "5xx (range)" }, "properties": [
            { "id": "decimals", "value": 0 }, { "id": "noValue", "value": "-" },
            { "id": "custom.cellOptions", "value": { "type": "color-background" } },
            { "id": "thresholds", "value": { "mode": "absolute", "steps": [
              { "color": "transparent", "value": null }, { "color": "green", "value": 0 }, { "color": "red", "value": 1 } ] } } ] },
          { "matcher": { "id": "byName", "options": "Avg Latency (ms)" }, "properties": [
            { "id": "unit", "value": "ms" }, { "id": "decimals", "value": 1 }, { "id": "noValue", "value": "-" },
            { "id": "custom.cellOptions", "value": { "type": "color-background" } },
            { "id": "thresholds", "value": { "mode": "absolute", "steps": [
              { "color": "transparent", "value": null }, { "color": "green", "value": 0 }, { "color": "yellow", "value": 500 }, { "color": "red", "value": 1000 } ] } } ] },
          { "matcher": { "id": "byName", "options": "Heap %" }, "properties": [
            { "id": "unit", "value": "percent" }, { "id": "decimals", "value": 1 }, { "id": "noValue", "value": "-" },
            { "id": "custom.cellOptions", "value": { "type": "color-background" } },
            { "id": "thresholds", "value": { "mode": "absolute", "steps": [
              { "color": "transparent", "value": null }, { "color": "green", "value": 0 }, { "color": "yellow", "value": 75 }, { "color": "red", "value": 85 } ] } } ] },
          { "matcher": { "id": "byName", "options": "GC Time %" }, "properties": [
            { "id": "unit", "value": "percent" }, { "id": "decimals", "value": 2 }, { "id": "noValue", "value": "-" },
            { "id": "custom.cellOptions", "value": { "type": "color-background" } },
            { "id": "thresholds", "value": { "mode": "absolute", "steps": [
              { "color": "transparent", "value": null }, { "color": "green", "value": 0 }, { "color": "yellow", "value": 2 }, { "color": "red", "value": 5 } ] } } ] },
          { "matcher": { "id": "byName", "options": "Mem % of Limit" }, "properties": [
            { "id": "unit", "value": "percent" }, { "id": "decimals", "value": 1 }, { "id": "noValue", "value": "-" },
            { "id": "custom.cellOptions", "value": { "type": "color-background" } },
            { "id": "thresholds", "value": { "mode": "absolute", "steps": [
              { "color": "transparent", "value": null },
              { "color": "blue", "value": 0 },
              { "color": "green", "value": 25 },
              { "color": "yellow", "value": 75 },
              { "color": "red", "value": 90 } ] } } ] },
          { "matcher": { "id": "byName", "options": "CPU % of Limit" }, "properties": [
            { "id": "unit", "value": "percent" }, { "id": "decimals", "value": 1 }, { "id": "noValue", "value": "-" },
            { "id": "custom.cellOptions", "value": { "type": "color-background" } },
            { "id": "thresholds", "value": { "mode": "absolute", "steps": [
              { "color": "transparent", "value": null },
              { "color": "blue", "value": 0 },
              { "color": "green", "value": 25 },
              { "color": "yellow", "value": 75 },
              { "color": "red", "value": 90 } ] } } ] },
          { "matcher": { "id": "byName", "options": "CPU Throttle %" }, "properties": [
            { "id": "unit", "value": "percent" }, { "id": "decimals", "value": 1 }, { "id": "noValue", "value": "-" },
            { "id": "custom.cellOptions", "value": { "type": "color-background" } },
            { "id": "thresholds", "value": { "mode": "absolute", "steps": [
              { "color": "transparent", "value": null }, { "color": "green", "value": 0 }, { "color": "yellow", "value": 5 }, { "color": "red", "value": 25 } ] } } ] },
          { "matcher": { "id": "byName", "options": "Mem Used (pod)" }, "properties": [
            { "id": "unit", "value": "bytes" }, { "id": "decimals", "value": 0 }, { "id": "noValue", "value": "-" } ] }
        ]
      }
    },

    {
      "type": "table",
      "title": "Sizing Actions - worst replica vs its limits",
      "description": "BLUE (<25%) = over-provisioned, limits can likely be reduced. RED (>90%) = at risk, raise the limit. Sorted by memory pressure. This is the reclaim/act worklist.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 10, "w": 24, "x": 0, "y": 13 },
      "targets": [
        { "refId": "A", "instant": true, "format": "table",
          "expr": "100 * max by (app) (label_replace(kubernetes_io:container_memory_limit_utilization{monitored_resource=\"k8s_container\", namespace_name=\"$namespace\", memory_type=\"non-evictable\", container_name!=\"istio-proxy\"}, \"app\", \"$1\", \"pod_name\", \"(.+)-[a-z0-9]+-[a-z0-9]+$\"))" },
        { "refId": "B", "instant": true, "format": "table",
          "expr": "100 * max by (app) (label_replace(kubernetes_io:container_cpu_limit_utilization{monitored_resource=\"k8s_container\", namespace_name=\"$namespace\", container_name!=\"istio-proxy\"}, \"app\", \"$1\", \"pod_name\", \"(.+)-[a-z0-9]+-[a-z0-9]+$\"))" },
        { "refId": "C", "instant": true, "format": "table",
          "expr": "100 * max by (app) (label_replace(kubernetes_io:container_memory_request_utilization{monitored_resource=\"k8s_container\", namespace_name=\"$namespace\", memory_type=\"non-evictable\", container_name!=\"istio-proxy\"}, \"app\", \"$1\", \"pod_name\", \"(.+)-[a-z0-9]+-[a-z0-9]+$\"))" },
        { "refId": "D", "instant": true, "format": "table",
          "expr": "100 * max by (app) (label_replace(kubernetes_io:container_cpu_request_utilization{monitored_resource=\"k8s_container\", namespace_name=\"$namespace\", container_name!=\"istio-proxy\"}, \"app\", \"$1\", \"pod_name\", \"(.+)-[a-z0-9]+-[a-z0-9]+$\"))" }
      ],
      "transformations": [
        { "id": "merge", "options": {} },
        { "id": "organize", "options": {
            "indexByName": { "app": 0, "Value #A": 1, "Value #B": 2, "Value #C": 3, "Value #D": 4 },
            "renameByName": {
              "app": "Service",
              "Value #A": "Mem % of Limit",
              "Value #B": "CPU % of Limit",
              "Value #C": "Mem % of Request",
              "Value #D": "CPU % of Request"
            },
            "excludeByName": { "Time": true }
        } },
        { "id": "sortBy", "options": { "sort": [{ "field": "Mem % of Limit", "desc": true }] } }
      ],
      "fieldConfig": {
        "defaults": { "unit": "percent", "decimals": 1, "noValue": "-",
          "custom": { "cellOptions": { "type": "color-background" } },
          "thresholds": { "mode": "absolute", "steps": [
            { "color": "transparent", "value": null },
            { "color": "blue", "value": 0 },
            { "color": "green", "value": 25 },
            { "color": "yellow", "value": 75 },
            { "color": "red", "value": 90 } ] } },
        "overrides": [
          { "matcher": { "id": "byName", "options": "Service" }, "properties": [
            { "id": "unit", "value": "string" },
            { "id": "custom.cellOptions", "value": { "type": "auto" } } ] }
        ]
      }
    },

    {
      "type": "timeseries",
      "title": "Memory % of Limit by Service (OOMKill risk trend)",
      "description": "Worst replica per service. Climbing toward 100% = pod will be OOMKilled.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 23 },
      "targets": [
        { "expr": "100 * max by (app) (label_replace(kubernetes_io:container_memory_limit_utilization{monitored_resource=\"k8s_container\", namespace_name=\"$namespace\", memory_type=\"non-evictable\", container_name!=\"istio-proxy\"}, \"app\", \"$1\", \"pod_name\", \"(.+)-[a-z0-9]+-[a-z0-9]+$\"))", "legendFormat": "{{app}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "fillOpacity": 5 } }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "CPU % of Limit & Throttling by Service",
      "description": "High utilization + high throttling = undersized. Low utilization + high throttling = bursty workload against a tight cap.",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 23 },
      "targets": [
        { "expr": "100 * max by (app) (label_replace(kubernetes_io:container_cpu_limit_utilization{monitored_resource=\"k8s_container\", namespace_name=\"$namespace\", container_name!=\"istio-proxy\"}, \"app\", \"$1\", \"pod_name\", \"(.+)-[a-z0-9]+-[a-z0-9]+$\"))", "legendFormat": "util {{app}}" },
        { "expr": "100 * max by (app) (label_replace(rate(container_cpu_cfs_throttled_periods_total{namespace=\"$namespace\", container!=\"\", container!=\"istio-proxy\", container!=\"POD\"}[5m]), \"app\", \"$1\", \"pod\", \"(.+)-[a-z0-9]+-[a-z0-9]+$\")) / max by (app) (label_replace(rate(container_cpu_cfs_periods_total{namespace=\"$namespace\", container!=\"\", container!=\"istio-proxy\", container!=\"POD\"}[5m]), \"app\", \"$1\", \"pod\", \"(.+)-[a-z0-9]+-[a-z0-9]+$\"))", "legendFormat": "throttle {{app}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "custom": { "fillOpacity": 5 } }, "overrides": [] }
    },

    {
      "type": "timeseries",
      "title": "Request Rate by Service",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 31 },
      "targets": [
        { "expr": "sum by (app) (rate(http_server_requests_seconds_count{namespace=\"$namespace\", uri!~\"/actuator.*\"}[5m]))", "legendFormat": "{{app}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 10, "stacking": { "mode": "normal" } } }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "5xx Rate by Service (empty = healthy)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 31 },
      "targets": [
        { "expr": "sum by (app) (rate(http_server_requests_seconds_count{namespace=\"$namespace\", status=~\"5..\"}[5m])) > 0", "legendFormat": "{{app}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "reqps", "custom": { "fillOpacity": 15 } }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Heap % by Service",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 39 },
      "targets": [
        { "expr": "100 * sum by (app) (jvm_memory_used_bytes{namespace=\"$namespace\", area=\"heap\"}) / sum by (app) (jvm_memory_max_bytes{namespace=\"$namespace\", area=\"heap\"})", "legendFormat": "{{app}}" }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "fillOpacity": 5 } }, "overrides": [] }
    },
    {
      "type": "timeseries",
      "title": "Namespace Totals - CPU & Memory (dedicated nodepool footprint)",
      "datasource": { "type": "prometheus", "uid": "${datasource}" },
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 39 },
      "targets": [
        { "expr": "sum(rate(container_cpu_usage_seconds_total{namespace=\"$namespace\", container!=\"\", container!=\"POD\"}[5m]))", "legendFormat": "total CPU (cores)" },
        { "expr": "sum(container_memory_working_set_bytes{namespace=\"$namespace\", container!=\"\", container!=\"POD\"}) / 1024 / 1024 / 1024", "legendFormat": "total memory (GiB)" }
      ],
      "fieldConfig": { "defaults": { "unit": "short", "decimals": 1, "custom": { "fillOpacity": 5 } }, "overrides": [] }
    }
  ]
}
